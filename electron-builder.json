{
  "appId": "com.quotation.desktop",
  "productName": "LST Quotation Desktop App",
  "directories": {
    "output": "dist"
  },
  "npmRebuild": false,
  "files": [
    "electron/**/*",
    "front/dist/**/*",
    "back/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "electron/**/*"
  ],
  "extraResources": [
    {
      "from": "electron/preload.cjs",
      "to": "electron/preload.cjs"
    },
    {
      "from": "back/.env",
      "to": "back/.env"
    },
    {
      "from": "back/template",
      "to": "back/template"
    }
  ],
  "win": {
    "target": "dir",
    "icon": "build/lst-logo.ico"
  }
}